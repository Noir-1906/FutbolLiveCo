<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
   version="6.0">

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- HttpOnly: JS no puede leer la cookie de sesión -->
            <http-only>true</http-only>
            <!-- Secure: solo HTTPS (comentar si usas HTTP en desarrollo local) -->
            <!-- <secure>true</secure> -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Directorio base para fotos de perfil (fuera del WAR) -->
    <!-- Cambia esto en producción a una ruta absoluta segura -->
    <context-param>
        <param-name>fotos.dir</param-name>
        <param-value>${user.home}/futbolliveco-fotos</param-value>
    </context-param>

</web-app>
